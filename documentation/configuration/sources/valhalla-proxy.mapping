{
    "route": {
        "method": "POST",
        "path": "/route",
        "body": {
            "locations": {
                "$for": "coordinates",
                "$as": { "lat": "${item.1}", "lon": "${item.0}" }
            },
            "costing": "${cost.costing}",
            "costing_options": { "${cost.costing}": "${cost.options}" },
            "format": "osrm",
            "date_time": {
                "$if": "date_time",
                "$then": { "type": 1, "value": "${date_time}" }
            }
        },
        "response": {
            "format": "osrm",
            "polylinePrecision": 6
        }
    },
    "isochrone": {
        "method": "POST",
        "path": "/isochrone",
        "body": {
            "locations": [
                { "lat": "${point.1}", "lon": "${point.0}" }
            ],
            "costing": "${cost.costing}",
            "costing_options": { "${cost.costing}": "${cost.options}" },
            "contours": [
                { "${costType}": { "$divide": ["${costValue}", "${cost.contourDivisor}"] } }
            ],
            "reverse": {
                "$lookup": { "value": "${direction}", "table": { "arrival": true }, "default": false }
            },
            "polygons": true,
            "date_time": {
                "$if": "date_time",
                "$then": { "type": 1, "value": "${date_time}" }
            }
        },
        "response": {
            "format": "geojson"
        }
    }
}
